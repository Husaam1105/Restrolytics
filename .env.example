# Copy to .env and fill in. Never commit .env.

# --- Supabase (Project Settings → API) ---
# Browser-safe values (exposed to the client bundle)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Same values for server-side rendering
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses RLS: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- AI (optional; IQ Copilot, Manager Assist, invoice reader) ---
# Leave AI_PROVIDER empty to run with AI features switched off.
AI_PROVIDER=            # openai | openrouter
AI_API_KEY=
AI_BASE_URL=            # optional, any OpenAI-compatible endpoint
AI_MODEL_CHAT=
AI_MODEL_VISION=        # optional, defaults to AI_MODEL_CHAT

# --- Jobs ---
# Bearer token the scheduler sends to POST /api/public/hooks/vendor-sync.
# Generate with: openssl rand -hex 32
VENDOR_SYNC_SECRET=

# --- Build target (optional) ---
# vercel | netlify | cloudflare-module | node-server (default)
NITRO_PRESET=
